<!DOCTYPE html>
<html>

<head>
  <title>OutSide-newtab</title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://code.jquery.com/jquery-4.0.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://kit.fontawesome.com/4323aee170.js" crossorigin="anonymous"></script>
</head>

<body>
  {{{body}}}

  <script type="module">
    import { LiquidGlass } from 'https://cdn.jsdelivr.net/npm/@ybouane/liquidglass/dist/index.js';

    const glassEl = document.querySelector('#weather-card');
    glassEl.dataset.config = JSON.stringify({
      floating: true,
        blurAmount: 0.25,
        cornerRadius: 30,
    });

    const instance = await LiquidGlass.init({
      root: document.querySelector('#background'),
      glassElements: [glassEl],
    });


  </script>

</body>

</html>