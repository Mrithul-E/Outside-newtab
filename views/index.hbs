<div>
    <div class="container-fluid vh-100 d-flex justify-content-center align-items-center" id="background">
        <img id="background-image" src="/images/bessi-tree-736882_1920.jpg" draggable="false">
        <div class="" id="weather-card">
            <h1 id="weather-emoji">🌞</h1>
            <span id="temparature">---</span>
            <span id="weather">------</span>
            <div class="mt-3" id="weather-details">
                <div>
                    <i class="fa-solid fa-droplet"></i>
                    <span id="humidity">--%</span>
                </div>
                <div>
                    <i class="fa-solid fa-wind"></i>
                    <span id="wind">-- km/h</span>
                </div>
            </div>
            <span id="weather-time" class="pt-2">Updated: --:--</span>
        </div>
        <div class="w-100 px-3" style="max-width: 700px;">
            <div id="clock"></div>
            <div class="input-group rounded-5 overflow-hidden border" id="search-container">
                <input type="text" name="" id="searchBox" class="form-control form-control-lg border-0"
                    placeholder="Search anything..." autocomplete="off">
                <button class="btn btn-outline-secondary border-0 border-start" type="button" id="search-btn">
                    <i class="fa-solid fa-magnifying-glass" id="search-icon"></i>
                </button>
            </div>
            <div class="w-100">

            </div>
        </div>
    </div>
</div>

<script src="/javascripts/main.js"></script>